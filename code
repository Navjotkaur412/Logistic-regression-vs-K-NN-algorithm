import matplotlib.pyplot as plt
import numpy as np
models = ["Logistic Regression", "KNN"]
accuracy = [
    logistic_accuracy * 100,
    knn_accuracy * 100
]
recall = [
    logistic_recall * 100,
    knn_recall * 100
]
f1_score_values = [
    logistic_f1 * 100,
    knn_f1 * 100
]
x = np.arange(len(models))
width = 0.25
plt.figure(figsize=(10, 6))
# Accuracy Bars
plt.bar(
    x - width,
    accuracy,
    width,
    label="Accuracy"
)
# Recall Bars
plt.bar(
    x,
    recall,
    width,
    label="Recall"
)
# F1 Score Bars
plt.bar(
    x + width,
    f1_score_values,
    width,
    label="F1 Score"
)
plt.xlabel("Machine Learning Models")
plt.ylabel("Score (%)")
plt.title("Logistic Regression vs KNN Comparison")
plt.xticks(x, models)
plt.ylim(0, 110)
plt.legend()
# Display values on bars
for i in range(len(models)):
    plt.text(
        x[i] - width,
        accuracy[i] + 2,
        f"{accuracy[i]:.2f}%",
        ha="center"
    )
    plt.text(
        x[i],
        recall[i] + 2,
        f"{recall[i]:.2f}%",
        ha="center"
    )
    plt.text(
        x[i] + width,
        f1_score_values[i] + 2,
        f"{f1_score_values[i]:.2f}%",
        ha="center"
    )
plt.tight_layout()
plt.show()
